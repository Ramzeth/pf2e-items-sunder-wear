<div class="dialog-content" style="display: flex; flex-direction: column; gap: 10px;">
    
    <div style="display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 1.1em;">
        <img src="{{item.img}}" style="width: 36px; height: 36px; border: 1px solid #444; border-radius: 4px; object-fit: cover; flex-shrink: 0;">
        <strong>{{item.name}} ({{localize "pf2e-items-sunder-wear.sheet-text.hp-short"}}: {{currentHp}} / {{repairLimit}})</strong>
    </div>
    
    <hr style="margin: 0;">

    <div class="form-group">
        <label>{{localize "pf2e-items-sunder-wear.dialog.repair.crafting-proficiency"}}</label>
        <span class="aztec-repair-repairer">{{repairerLine}}</span>
    </div>

    <div class="form-group">
        <label>{{localize "pf2e-items-sunder-wear.dialog.repair.grade"}}</label>
        <select id="repair-tier" style="width: 100%;"></select>
    </div>

    <div class="form-group">
        <label>{{localize "pf2e-items-sunder-wear.dialog.repair.repair-dc"}}</label>
        {{#if dcEditable}}
        <input type="number" id="repair-dc" value="{{dc}}">
        {{else}}
        <span class="aztec-repair-dc">{{dc}}</span>
        {{/if}}
    </div>

    <div style="text-align: center; font-size: 0.9em; color: var(--color-text-dark-secondary);">
        <span id="repair-restores-info">{{restoresInfo}}</span>
    </div>

    <div id="repair-forecast"></div>

    <div style="display: flex; justify-content: center; gap: 6px; margin-top: 8px;">
        <button type="button" data-action="repair" style="flex: 1;"><i class="fa-solid fa-dice-d20"></i> {{localize "pf2e-items-sunder-wear.dialog.repair.roll-crafting"}}</button>
        <button type="button" data-action="requestRepair" style="flex: 1;" data-tooltip="{{localize "pf2e-items-sunder-wear.dialog.repair.request-hint"}}"><i class="fa-solid fa-bullhorn"></i> {{localize "pf2e-items-sunder-wear.dialog.repair.request"}}</button>
    </div>
</div>